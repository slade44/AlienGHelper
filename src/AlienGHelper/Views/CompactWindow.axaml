<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TccG15.Views.CompactWindow"
        Title="Alien G-Helper"
        Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="Transparent">

    <!-- Interface compacta no estilo do G-Helper: uma coluna, botões grandes, o resto abre na janela completa -->

    <StackPanel>
        <!-- barra de título -->
        <Grid Height="32">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Spacing="8">
                <Image Source="avares://AlienGHelper/Resources/alien_icon.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock x:Name="TitleText" Text="ALIEN G-HELPER" FontSize="12" FontWeight="Bold" LetterSpacing="0.6" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Margin="16,8,16,16">

            <!-- ===== controle dos fans (modo térmico da BIOS) ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="3,0,3,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="icon filled" Data="M 12.00,11.00 C 9.50,8.00 9.50,3.00 12.50,2.50 C 15.50,2.50 15.00,7.50 12.00,11.00 Z M 12.87,12.50 C 16.71,11.83 21.04,14.33 19.98,17.18 C 18.48,19.78 14.40,16.85 12.87,12.50 Z M 11.13,12.50 C 9.79,16.17 5.46,18.67 3.52,16.32 C 2.02,13.72 6.60,11.65 11.13,12.50 Z M 10,12 A 2,2 0 1 0 14,12 A 2,2 0 1 0 10,12 Z"/></Canvas></Viewbox>
                    <TextBlock x:Name="ModeTitle" Classes="sec" Text="Fan Control: —"/>
                </StackPanel>
                <TextBlock x:Name="FanStat" Grid.Column="1" Classes="stat num" Text="CPU -- · GPU -- RPM"/>
            </Grid>
            <Grid Classes="row4" ColumnDefinitions="*,*,*,*">
                <Border x:Name="BtnSilent" Grid.Column="0" Classes="big" Tag="Quiet" PointerReleased="Mode_Click" ToolTip.Tip="Quiet BIOS profile">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M20 14.5 A8 8 0 1 1 9.5 4 A6.5 6.5 0 0 0 20 14.5 Z"/></Canvas></Viewbox>
                        <TextBlock Text="Silent"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnBalanced" Grid.Column="1" Classes="big" Tag="Balanced" PointerReleased="Mode_Click" ToolTip.Tip="Balanced BIOS profile">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M12 4 V20 M5 7 H19 M5 7 L2.5 13 H7.5 Z M19 7 L16.5 13 H21.5 Z M8 20 H16"/></Canvas></Viewbox>
                        <TextBlock Text="Balanced"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnTurbo" Grid.Column="2" Classes="big" Tag="GMode" PointerReleased="Mode_Click" ToolTip.Tip="G-Mode (fans and power at maximum)">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M13.5 2 L5 13.5 H11.5 L10.5 22 L19 10.5 H12.5 Z"/></Canvas></Viewbox>
                        <TextBlock Text="Turbo"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnFans" Grid.Column="3" Classes="big" Tag="Fans" PointerReleased="Mode_Click" ToolTip.Tip="Fan curves and power limits (Manual mode)">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon filled" Data="M 12.00,11.00 C 9.50,8.00 9.50,3.00 12.50,2.50 C 15.50,2.50 15.00,7.50 12.00,11.00 Z M 12.87,12.50 C 16.71,11.83 21.04,14.33 19.98,17.18 C 18.48,19.78 14.40,16.85 12.87,12.50 Z M 11.13,12.50 C 9.79,16.17 5.46,18.67 3.52,16.32 C 2.02,13.72 6.60,11.65 11.13,12.50 Z M 10,12 A 2,2 0 1 0 14,12 A 2,2 0 1 0 10,12 Z"/></Canvas></Viewbox>
                        <TextBlock Text="Fans + Power"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- ===== energia da CPU (TDP pela SMU, via PawnIO) ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="3,0,3,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M13.5 2 L5 13.5 H11.5 L10.5 22 L19 10.5 H12.5 Z"/></Canvas></Viewbox>
                    <TextBlock x:Name="PowerTitle" Classes="sec" Text="Power: —"/>
                </StackPanel>
                <TextBlock x:Name="PowerStat" Grid.Column="1" Classes="stat num" Text=""/>
            </Grid>
            <Grid Classes="row4" ColumnDefinitions="*,*,*,*">
                <Border x:Name="BtnEco" Grid.Column="0" Classes="big" Tag="Eco" PointerReleased="Power_Click" ToolTip.Tip="CPU TDP 15 W (boost 20 W): cool, quiet, longer battery">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M5 19 C5 10 11 5 20 4 C19 13 14 19 5 19 Z M5 19 L13 11"/></Canvas></Viewbox>
                        <TextBlock Text="Eco"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnPowBalanced" Grid.Column="1" Classes="big" Tag="Balanced" PointerReleased="Power_Click" ToolTip.Tip="CPU TDP 45 W (boost 54 / 65 W), the 6800H default">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M12 3 A9 9 0 1 0 12.01 3 Z M12 3 V21"/><Path Classes="icon filled" Data="M12 3 A9 9 0 0 1 12 21 Z"/></Canvas></Viewbox>
                        <TextBlock Text="Balanced"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnPerformance" Grid.Column="2" Classes="big" Tag="Performance" PointerReleased="Power_Click" ToolTip.Tip="CPU TDP 90 W (boost 100 / 110 W): as fast as the cooling allows">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M4 17 A8.5 8.5 0 1 1 20 17 M12 15 L16.5 8.5 M12 15 A1 1 0 1 0 12.01 15"/></Canvas></Viewbox>
                        <TextBlock Text="Performance"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BtnPowCustom" Grid.Column="3" Classes="big" Tag="Custom" PointerReleased="Power_Click" ToolTip.Tip="Your own CPU limits, GPU clocks and undervolt">
                    <StackPanel>
                        <Viewbox><Canvas Width="24" Height="24"><Path Classes="icon" Data="M4 7 H20 M4 12 H20 M4 17 H20"/><Path Classes="icon filled" Data="M 13,7 A 2,2 0 1 0 17,7 A 2,2 0 1 0 13,7 Z M 6,12 A 2,2 0 1 0 10,12 A 2,2 0 1 0 6,12 Z M 10,17 A 2,2 0 1 0 14,17 A 2,2 0 1 0 10,17 Z"/></Canvas></Viewbox>
                        <TextBlock Text="Custom"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="PowerHint" Classes="tertiary" FontSize="11" Margin="3,6,3,0" TextWrapping="Wrap" IsVisible="False"/>

            <Border Classes="divider"/>

            <!-- ===== sistema (resumo do Monitor) ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="3,0,3,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M2 12 H6.5 L9 6 L13 18 L15.5 12 H22"/></Canvas></Viewbox>
                    <TextBlock Classes="sec" Text="System"/>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="3,0,3,6">
                <Border Grid.Column="0" Classes="tile" Padding="10,7" Margin="0,0,3,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="caps" Text="CPU" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CpuTempText" Grid.Column="1" Classes="num" FontSize="17" FontWeight="Bold" Text="-- °C" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Classes="tile" Padding="10,7" Margin="3,0,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="caps" Text="GPU" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="GpuTempText" Grid.Column="1" Classes="num" FontSize="17" FontWeight="Bold" Text="-- °C" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" Margin="3,0">
                <Border Grid.Column="0" Classes="tile" Padding="10,8" Margin="0,0,3,0">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="caps" Text="CPU" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuUse" Grid.Column="1" Classes="num" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--"/>
                        </Grid>
                        <ProgressBar x:Name="CpuUseBar" Classes="thin" Minimum="0" Maximum="100" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="CpuMore" Classes="mini num" FontSize="11" Text="-- MHz · -- W" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="tile" Padding="10,8" Margin="3,0,3,0">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="caps" Text="GPU" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GpuUse" Grid.Column="1" Classes="num" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--"/>
                        </Grid>
                        <ProgressBar x:Name="GpuUseBar" Classes="thin" Minimum="0" Maximum="100" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="GpuMore" Classes="mini num" FontSize="11" Text="-- MHz · -- W" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="tile" Padding="10,8" Margin="3,0,0,0">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="caps" Text="RAM" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RamUse" Grid.Column="1" Classes="num" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--"/>
                        </Grid>
                        <ProgressBar x:Name="RamUseBar" Classes="thin" Minimum="0" Maximum="100" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="RamStat" Classes="mini num" FontSize="11" Text="-- / -- GB" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- ===== teclado ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="3,0,3,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M4.5 6 H19.5 A2.5 2.5 0 0 1 22 8.5 V15.5 A2.5 2.5 0 0 1 19.5 18 H4.5 A2.5 2.5 0 0 1 2 15.5 V8.5 A2.5 2.5 0 0 1 4.5 6 Z M5.5 10 H7 M9.5 10 H11 M13.5 10 H15 M17.5 10 H19 M7.5 14 H16.5"/></Canvas></Viewbox>
                    <TextBlock Classes="sec" Text="Laptop Keyboard"/>
                </StackPanel>
                <CheckBox x:Name="KbOn" Grid.Column="1" MinWidth="0" Padding="6,0,0,0" HorizontalAlignment="Right" Content="Lights"/>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" Margin="0">
                <ComboBox x:Name="KbEffect" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" Margin="3,0"/>
                <Button x:Name="KbColor" Grid.Column="1" Classes="foot" ToolTip.Tip="Color of the whole keyboard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Color" VerticalAlignment="Center"/>
                        <Border x:Name="KbSwatch" Width="14" Height="14" CornerRadius="3" BorderThickness="1"
                                BorderBrush="#5A808080" Background="#00E5FF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="foot" Tag="Keyboard" Click="OpenPage_Click" ToolTip.Tip="Keyboard window: zones, effects and device options">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M12 8.5 A3.5 3.5 0 1 0 12.01 8.5 Z M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M4.9 4.9 L7 7 M17 17 L19.1 19.1 M4.9 19.1 L7 17 M17 7 L19.1 4.9"/></Canvas></Viewbox>
                        <TextBlock Text="Extra" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="3,10,3,0">
                <TextBlock Classes="mini" Text="Brightness" VerticalAlignment="Center"/>
                <Slider x:Name="KbBright" Grid.Column="1" Minimum="0" Maximum="100" Margin="12,-6,12,-6" VerticalAlignment="Center"/>
                <TextBlock x:Name="KbBrightVal" Grid.Column="2" Classes="mini num" Text="100 %" VerticalAlignment="Center" MinWidth="38" TextAlignment="Right"/>
            </Grid>
            <TextBlock x:Name="KbHint" Classes="tertiary" FontSize="11" Margin="3,6,3,0" TextWrapping="Wrap" IsVisible="False"/>

            <Border Classes="divider"/>

            <!-- ===== bateria (limite de carga da BIOS Dell) ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="3,0,3,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M4 7 H17 A2 2 0 0 1 19 9 V15 A2 2 0 0 1 17 17 H4 A2 2 0 0 1 2 15 V9 A2 2 0 0 1 4 7 Z M22 10.5 V13.5 M10.5 9.5 L8.5 12 H12 L10 14.5"/></Canvas></Viewbox>
                    <TextBlock x:Name="BatteryTitle" Classes="sec" Text="Battery Charge Limit"/>
                </StackPanel>
                <TextBlock x:Name="BatteryLevel" Grid.Column="1" Classes="stat num" Text=""/>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="0">
                <ComboBox x:Name="ChargeModeBox" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" Margin="3,0"
                          ToolTip.Tip="Battery charge mode stored in the BIOS (works with the app closed)"/>
                <TextBlock x:Name="ChargeModeHint" Grid.Column="1" Classes="mini" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="8,0,3,0"/>
            </Grid>
            <Grid x:Name="ChargeLimitRow" ColumnDefinitions="Auto,*,Auto" Margin="3,10,3,0">
                <TextBlock Classes="mini" Text="Stop at" VerticalAlignment="Center"/>
                <Slider x:Name="ChargeSlider" Grid.Column="1" Minimum="55" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Margin="12,-6,12,-6" VerticalAlignment="Center"/>
                <TextBlock x:Name="ChargeVal" Grid.Column="2" Classes="mini num" FontWeight="Bold" Text="80 %" MinWidth="38"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="BatteryHint" Classes="tertiary" FontSize="11" Margin="3,6,3,0" TextWrapping="Wrap"/>

            <Border Classes="divider"/>

            <!-- ===== rodapé ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="3,0,3,10">
                <CheckBox x:Name="RunOnStartup" MinWidth="0" Padding="6,0,0,0" Content="Run on Startup"/>
                <Border x:Name="ProfileBadge" Grid.Column="1" Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="ProfileText" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="FailSafeText" Grid.Column="1" Classes="tertiary num" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="foot" Tag="Monitor" Click="OpenPage_Click" ToolTip.Tip="Charts, FPS monitor and all sensors">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M2 12 H6.5 L9 6 L13 18 L15.5 12 H22"/></Canvas></Viewbox>
                        <TextBlock Text="Monitor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="foot" Tag="Extra" Click="OpenPage_Click" ToolTip.Tip="App profiles, fail-safe, appearance and other settings">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M3 6 H21 M3 12 H21 M3 18 H21"/></Canvas></Viewbox>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="foot" Click="Quit_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M12 3 V12 M6.3 6.3 A8 8 0 1 0 17.7 6.3"/></Canvas></Viewbox>
                        <TextBlock Text="Quit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
