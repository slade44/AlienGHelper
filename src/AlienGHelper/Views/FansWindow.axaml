<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:TccG15.Controls"
        xmlns:v="using:TccG15.Views"
        x:Class="TccG15.Views.FansWindow"
        Title="Alien G-Helper — Fans and Power"
        Width="1000" Height="800" MinWidth="860" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="Transparent">

    <!-- "Fans and Power" do G-Helper: energia à esquerda, curvas dos fans à direita -->
    <Grid RowDefinitions="32,*">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Source="avares://AlienGHelper/Resources/alien_icon.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <TextBlock Text="ALIEN G-HELPER" FontSize="12" FontWeight="Bold" LetterSpacing="0.6" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="Fans and Power" FontSize="12" Classes="secondary" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="10,6,14,14">

            <v:PowerPage x:Name="PowerView" Margin="0,0,12,0"/>

            <!-- ===== curvas ===== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Classes="icon filled" Data="M 12.00,11.00 C 9.50,8.00 9.50,3.00 12.50,2.50 C 15.50,2.50 15.00,7.50 12.00,11.00 Z M 12.87,12.50 C 16.71,11.83 21.04,14.33 19.98,17.18 C 18.48,19.78 14.40,16.85 12.87,12.50 Z M 11.13,12.50 C 9.79,16.17 5.46,18.67 3.52,16.32 C 2.02,13.72 6.60,11.65 11.13,12.50 Z M 10,12 A 2,2 0 1 0 14,12 A 2,2 0 1 0 10,12 Z"/></Canvas></Viewbox>
                        <TextBlock Classes="sec" Text="Fan Curves" FontSize="15"/>
                        <Border x:Name="ProfileBadge" Classes="badge" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock x:Name="ProfileBadgeText" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <ComboBox x:Name="ModeBox" Grid.Column="2" Width="190" Height="32" VerticalAlignment="Center"
                              ToolTip.Tip="Thermal mode (Manual = fans follow these curves)"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <CheckBox x:Name="ClampToggle" Content="Clamp to Grid" ToolTip.Tip="Points move in steps of 5 °C and 5 %"/>
                    <TextBlock x:Name="CurveStat" Classes="tertiary num" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="CurvesBox" Grid.Row="2" RowDefinitions="*,*">
                    <Border Classes="tile" CornerRadius="4" Padding="6,8,10,4" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="CPU Fan Profile, %/°C" FontSize="12.5" HorizontalAlignment="Center"/>
                            <c:CurveEditor x:Name="CpuEditor" Grid.Row="1" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="tile" CornerRadius="4" Padding="6,8,10,4" Margin="0,6,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="GPU Fan Profile, %/°C" FontSize="12.5" HorizontalAlignment="Center"/>
                            <c:CurveEditor x:Name="GpuEditor" Grid.Row="1" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
                    <Button x:Name="BtnFactoryDefaults" Classes="gh" Content="Factory Defaults" Click="FactoryDefaults_Click"
                            ToolTip.Tip="Restore the default CPU and GPU curves"/>
                    <Button x:Name="BtnCalibrate" Grid.Column="1" Classes="gh" Margin="6,0,0,0" Click="Calibrate_Click"
                            ToolTip.Tip="Finds the real top speed of each fan (the BIOS accepts more than 100 %). Fans run at full speed for 1–2 minutes">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Classes="icon" Data="M4 17 A8.5 8.5 0 1 1 20 17 M12 15 L16.5 8.5 M12 15 A1 1 0 1 0 12.01 15"/></Canvas></Viewbox>
                            <TextBlock x:Name="CalibrateText" Text="Calibrate" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="CurveEditHint" Grid.Column="2" Classes="tertiary" FontSize="11" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="10,0"/>
                    <CheckBox x:Name="ApplyCurveCheck" Grid.Column="3" Content="Apply Custom Fan Curve"
                              ToolTip.Tip="Fans follow these curves (Manual mode)"/>
                </Grid>
                <StackPanel Grid.Row="4" Margin="0,8,0,0" Spacing="3">
                    <TextBlock x:Name="CalibrationText" Classes="num" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModeInfoText" Classes="tertiary" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
